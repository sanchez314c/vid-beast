# VidBeast Environment Configuration Template
# Copy this file to .env and configure your settings

# ============================================
# Application Configuration
# ============================================
# Set log level: debug, info, warn, error
VIDBEAST_LOG_LEVEL=info

# Custom temporary directory for video processing
# VIDBEAST_TEMP_DIR=/path/to/temp

# Disable hardware acceleration (set to 1 if experiencing GPU issues)
# VIDBEAST_NO_HW_ACCEL=0

# ============================================
# Development Ports (for development mode)
# ============================================
# DEV_SERVER_PORT=56813
# ELECTRON_DEBUG_PORT=60799
# ELECTRON_INSPECT_PORT=61129

# ============================================
# AI Integration (Optional)
# ============================================
# OpenAI API Configuration
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4

# Google Gemini API Configuration
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-pro

# Anthropic Claude API Configuration
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-3-opus-20240229

# ============================================
# FFmpeg Configuration
# ============================================
# Custom FFmpeg binary path (leave empty to use bundled version)
# FFMPEG_PATH=/usr/local/bin/ffmpeg
# FFPROBE_PATH=/usr/local/bin/ffprobe

# ============================================
# Output Configuration
# ============================================
# Default output directory for repaired videos
# OUTPUT_DIR=./output

# Default frame extraction directory
# FRAMES_DIR=./frames

# ============================================
# Performance Configuration
# ============================================
# Maximum concurrent video processing jobs
# MAX_CONCURRENT_JOBS=4

# Memory limit for video processing (in MB)
# MEMORY_LIMIT=4096

# ============================================
# Security & Privacy
# ============================================
# Enable telemetry (0 = disabled, 1 = enabled)
# ENABLE_TELEMETRY=0

# ============================================
# Advanced Options
# ============================================
# Enable experimental features
# EXPERIMENTAL_FEATURES=0

# Debug mode (verbose logging and extended error messages)
# DEBUG_MODE=0
